{{ app_domain }} {
    encode zstd gzip

    @mutable_assets path / /index.html /styles.css
    header @mutable_assets Cache-Control "no-store"

    reverse_proxy {{ app_bind_address }}:{{ app_port }}

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
