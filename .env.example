# VPS / SSH (use an absolute path for SSH_KEY_PATH)
VPS_HOST=192.0.2.10
VPS_PORT=22
VPS_USER=deploy
SSH_KEY_PATH=/home/your-user/.ssh/id_ed25519

# Application
APP_NAME=iac-presentation
APP_DOMAIN=slides.example.com
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
CONTAINER_PORT=8000

# Docker
CONTAINER_NAME=iac-slides
RESTART_POLICY=unless-stopped

# Deploy
DEPLOY_PATH=/opt/iac-presentation

# Caddy
CADDY_ENABLED=true
CADDY_CONFIG_DIR=/etc/caddy/sites

